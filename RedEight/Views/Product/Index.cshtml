@model List<RedEight.Models.Product>
@{
    Layout = "_Layout";
    var catMap  = (Dictionary<string,string>)(ViewBag.CatMap  ?? new Dictionary<string,string>());
    var typeMap = (Dictionary<string,string>)(ViewBag.TypeMap ?? new Dictionary<string,string>());
    var cats    = (List<RedEight.Models.Category>)(ViewBag.CategoryList ?? new List<RedEight.Models.Category>());
    var types   = (List<RedEight.Models.Type>)(ViewBag.TypeList ?? new List<RedEight.Models.Type>());
}

@section Styles {
    <link rel="stylesheet" href="/site/css/admin.css" />
}

<div class="container my-5" style="padding-top:3.5rem;">
  @Html.AntiForgeryToken()

  <div class="admin-page-header">
    <div>
      <p class="sec-num">Admin · Management</p>
      <h1>Products</h1>
      <p>Create and manage products displayed in the catalogue.</p>
    </div>
    <button class="btn-r8" onclick="openCreateModal()"><i class="bi bi-plus-lg"></i> Create product</button>
  </div>

  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/Admin">Admin</a></li>
      <li class="breadcrumb-item active" aria-current="page">Products</li>
    </ol>
  </nav>

  <div class="admin-card">
    <div class="admin-table-toolbar">
      <div class="admin-search">
        <i class="bi bi-search"></i>
        <input type="text" id="prodSearch" placeholder="Search products…" oninput="filterTable()">
      </div>
      <span class="admin-count" id="prodCount">@Model.Count product@(Model.Count == 1 ? "" : "s")</span>
    </div>

    <div class="table-responsive">
      <table class="table admin-table" id="prodTable">
        <thead>
          <tr>
            <th style="width:4rem"></th>
            <th>Name</th>
            <th>Category</th>
            <th>Type</th>
            <th>Price</th>
            <th class="text-end" style="padding-right:1.25rem">Actions</th>
          </tr>
        </thead>
        <tbody id="prodBody">
          @foreach (var p in Model)
          {
            var catName  = catMap.TryGetValue(p.CategoryId.ToString(), out var cn) ? cn : p.CategoryId.ToString()[..8] + "…";
            var typeName = typeMap.TryGetValue(p.TypeId.ToString(),    out var tn) ? tn : p.TypeId.ToString()[..8] + "…";
            var priceStr = p.Price > 0 ? $"${p.Price:0.##}" : "—";
            <tr data-name="@p.Name.ToLower()">
              <td>
                <img src="/Images/Products/@p.Id/1.jpg"
                     class="prod-thumb" data-id="@p.Id"
                     alt="@p.Name"
                     style="width:48px;height:48px;object-fit:cover;"
                     onerror="if(!this.dataset.t){this.dataset.t='1';this.src='/Images/Products/@p.Id/1.png';}else{this.style.opacity='.15';}" />
              </td>
              <td style="font-weight:600">@p.Name</td>
              <td style="color:var(--c-mid);font-size:.82rem">@catName</td>
              <td style="color:var(--c-mid);font-size:.82rem">@typeName</td>
              <td style="font-size:.82rem">@priceStr</td>
              <td class="text-end">
                <button class="btn-tbl-edit me-1"
                        onclick="openEditModal(this)"
                        data-id="@p.Id"
                        data-name="@p.Name"
                        data-desc="@p.Description"
                        data-price="@p.Price"
                        data-catid="@p.CategoryId"
                        data-typeid="@p.TypeId"
                        data-sku="@p.Sku"
                        data-badge="@p.Badge"
                        data-badgetype="@p.BadgeType"
                        data-colors="@string.Join(",", p.Color ?? new())">
                  <i class="bi bi-pencil"></i> Edit
                </button>
                <button class="btn-tbl-upload me-1"
                        onclick="openImagesModal(this)"
                        data-id="@p.Id"
                        data-name="@p.Name">
                  <i class="bi bi-images"></i> Images
                </button>
                <button class="btn-tbl-delete"
                        onclick="openDeleteModal(this)"
                        data-id="@p.Id"
                        data-name="@p.Name">
                  <i class="bi bi-trash3"></i> Delete
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>

      <div class="admin-empty d-none" id="emptyState">
        <i class="bi bi-box-seam"></i>
        <p>No products match your search.</p>
      </div>
    </div>
  </div>
</div>

<!-- ── CREATE MODAL ────────────────────────────────────────────────── -->
<div class="r8-modal-backdrop" id="createModal" role="dialog" aria-modal="true" aria-labelledby="createModalTitle">
  <div class="r8-modal" style="max-width:520px">
    <div class="r8-modal-header">
      <h2 id="createModalTitle">Create product</h2>
      <button class="r8-modal-close" onclick="closeModal('createModal')" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="r8-modal-body">
      <div class="r8-form-group">
        <label class="r8-label" for="createName">Name</label>
        <input class="r8-input" type="text" id="createName" placeholder="Product name">
        <div class="r8-field-error" id="err-createName">Please enter a name.</div>
      </div>
      <div class="r8-form-group">
        <label class="r8-label" for="createDesc">Description</label>
        <textarea class="r8-input" id="createDesc" rows="3" placeholder="Short description…"></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem">
        <div class="r8-form-group">
          <label class="r8-label" for="createCategory">Category</label>
          <select class="r8-select r8-input" id="createCategory">
            <option value="">— none —</option>
            @foreach (var c in cats)
            {
              <option value="@c.Id">@c.Name</option>
            }
          </select>
        </div>
        <div class="r8-form-group">
          <label class="r8-label" for="createType">Type</label>
          <select class="r8-select r8-input" id="createType">
            <option value="">— none —</option>
            @foreach (var t in types)
            {
              <option value="@t.Id">@t.Name</option>
            }
          </select>
        </div>
      </div>
      <div class="r8-form-group">
        <label class="r8-label" for="createPrice">Price (CAD, 0 = on request)</label>
        <input class="r8-input" type="number" id="createPrice" min="0" step="1" value="0">
      </div>
      <div class="r8-form-group">
        <label class="r8-label" for="createSku">SKU / Reference</label>
        <input class="r8-input" type="text" id="createSku" placeholder="e.g. No. R8-101 · Armchair">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem">
        <div class="r8-form-group">
          <label class="r8-label" for="createBadge">Badge label</label>
          <input class="r8-input" type="text" id="createBadge" placeholder="e.g. Bestseller">
        </div>
        <div class="r8-form-group">
          <label class="r8-label" for="createBadgeType">Badge style</label>
          <select class="r8-select r8-input" id="createBadgeType">
            <option value="">— none —</option>
            <option value="red">Red</option>
            <option value="dark">Dark</option>
          </select>
        </div>
      </div>
      <div class="r8-form-group">
        <label class="r8-label">Colours</label>
        <div class="swatch-editor" id="createSwatchEditor"></div>
        <div style="display:flex;gap:.6rem;align-items:center;margin-top:.5rem">
          <input type="color" id="createColorPicker" value="#8B6F47" style="width:2.1rem;height:2.1rem;border:1px solid var(--c-line);cursor:pointer;padding:2px;background:none;border-radius:2px;">
          <button class="btn-cancel" style="padding:.28rem .75rem;font-size:.62rem" onclick="addColor('create')">+ Add colour</button>
        </div>
      </div>
    </div>
    <div class="r8-modal-footer">
      <button class="btn-cancel" onclick="closeModal('createModal')">Cancel</button>
      <button class="btn-r8" onclick="submitCreate()"><i class="bi bi-plus-lg"></i> Create product</button>
    </div>
  </div>
</div>

<!-- ── EDIT MODAL ──────────────────────────────────────────────────── -->
<div class="r8-modal-backdrop" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
  <div class="r8-modal" style="max-width:520px">
    <div class="r8-modal-header">
      <h2 id="editModalTitle">Edit product</h2>
      <button class="r8-modal-close" onclick="closeModal('editModal')" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="r8-modal-body">
      <input type="hidden" id="editId">
      <div class="r8-form-group">
        <label class="r8-label" for="editName">Name</label>
        <input class="r8-input" type="text" id="editName">
        <div class="r8-field-error" id="err-editName">Please enter a name.</div>
      </div>
      <div class="r8-form-group">
        <label class="r8-label" for="editDesc">Description</label>
        <textarea class="r8-input" id="editDesc" rows="3"></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem">
        <div class="r8-form-group">
          <label class="r8-label" for="editCategory">Category</label>
          <select class="r8-select r8-input" id="editCategory">
            <option value="">— none —</option>
            @foreach (var c in cats)
            {
              <option value="@c.Id">@c.Name</option>
            }
          </select>
        </div>
        <div class="r8-form-group">
          <label class="r8-label" for="editType">Type</label>
          <select class="r8-select r8-input" id="editType">
            <option value="">— none —</option>
            @foreach (var t in types)
            {
              <option value="@t.Id">@t.Name</option>
            }
          </select>
        </div>
      </div>
      <div class="r8-form-group">
        <label class="r8-label" for="editPrice">Price (CAD, 0 = on request)</label>
        <input class="r8-input" type="number" id="editPrice" min="0" step="1">
      </div>
      <div class="r8-form-group">
        <label class="r8-label" for="editSku">SKU / Reference</label>
        <input class="r8-input" type="text" id="editSku" placeholder="e.g. No. R8-101 · Armchair">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem">
        <div class="r8-form-group">
          <label class="r8-label" for="editBadge">Badge label</label>
          <input class="r8-input" type="text" id="editBadge" placeholder="e.g. Bestseller">
        </div>
        <div class="r8-form-group">
          <label class="r8-label" for="editBadgeType">Badge style</label>
          <select class="r8-select r8-input" id="editBadgeType">
            <option value="">— none —</option>
            <option value="red">Red</option>
            <option value="dark">Dark</option>
          </select>
        </div>
      </div>
      <div class="r8-form-group">
        <label class="r8-label">Colours</label>
        <div class="swatch-editor" id="editSwatchEditor"></div>
        <div style="display:flex;gap:.6rem;align-items:center;margin-top:.5rem">
          <input type="color" id="editColorPicker" value="#8B6F47" style="width:2.1rem;height:2.1rem;border:1px solid var(--c-line);cursor:pointer;padding:2px;background:none;border-radius:2px;">
          <button class="btn-cancel" style="padding:.28rem .75rem;font-size:.62rem" onclick="addColor('edit')">+ Add colour</button>
        </div>
      </div>
    </div>
    <div class="r8-modal-footer">
      <button class="btn-cancel" onclick="closeModal('editModal')">Cancel</button>
      <button class="btn-r8" onclick="submitEdit()"><i class="bi bi-check-lg"></i> Save changes</button>
    </div>
  </div>
</div>

<!-- ── IMAGES MODAL ────────────────────────────────────────────────── -->
<div class="r8-modal-backdrop" id="imagesModal" role="dialog" aria-modal="true" aria-labelledby="imagesModalTitle">
  <div class="r8-modal" style="max-width:600px">
    <div class="r8-modal-header">
      <h2 id="imagesModalTitle">Images</h2>
      <button class="r8-modal-close" onclick="closeModal('imagesModal')" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="r8-modal-body">
      <input type="hidden" id="imagesProductId">

      <div class="r8-label mb-1" style="margin-bottom:.5rem">Existing images</div>
      <div id="imagesGrid" class="prod-img-grid">
        <p style="color:var(--c-mid);font-size:.8rem">Loading…</p>
      </div>

      <div style="border-top:1px solid var(--c-line);margin:1.2rem 0"></div>

      <div class="r8-label" style="margin-bottom:.5rem">Upload new images</div>
      <p style="font-size:.72rem;color:var(--c-mid);margin-bottom:.7rem">Saved as <code>Images/Products/{id}/1.jpg</code>, <code>2.jpg</code>… New uploads continue numbering from the last existing file.</p>
      <div style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap">
        <input class="r8-input" type="file" id="imageUploadInput" accept="image/*" multiple style="flex:1;min-width:0;padding:.5rem .8rem;font-size:.78rem">
        <button class="btn-r8" style="white-space:nowrap" onclick="submitImageUpload()"><i class="bi bi-cloud-upload"></i> Upload</button>
      </div>
    </div>
    <div class="r8-modal-footer">
      <button class="btn-cancel" onclick="closeModal('imagesModal')">Close</button>
    </div>
  </div>
</div>

<!-- ── DELETE MODAL ────────────────────────────────────────────────── -->
<div class="r8-modal-backdrop" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
  <div class="r8-modal">
    <div class="r8-modal-header">
      <h2 id="deleteModalTitle">Delete product</h2>
      <button class="r8-modal-close" onclick="closeModal('deleteModal')" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="r8-modal-body delete-modal-body">
      <div class="delete-modal-icon"><i class="bi bi-trash3"></i></div>
      <p>Are you sure you want to delete <strong id="deleteTarget">"Product"</strong>? All data and images will be permanently removed.</p>
    </div>
    <div class="r8-modal-footer">
      <button class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
      <button class="btn-danger-r8" onclick="submitDelete()"><i class="bi bi-trash3"></i> Delete</button>
    </div>
  </div>
</div>

<!-- ── TOAST ── -->
<div class="r8-toast" id="toast" role="alert">
  <i class="bi bi-check-circle-fill" id="toastIcon"></i>
  <span id="toastMsg">Done</span>
</div>

<script>
  /* ── HELPERS ──────────────────────────────────────────────────────── */
  function openModal(id)  { const el=document.getElementById(id); if(el){ el.classList.add('open'); document.body.style.overflow='hidden'; } }
  function closeModal(id) { const el=document.getElementById(id); if(el){ el.classList.remove('open'); document.body.style.overflow=''; } }
  document.querySelectorAll('.r8-modal-backdrop').forEach(bd=>bd.addEventListener('click', e=>{ if(e.target===bd) { bd.classList.remove('open'); document.body.style.overflow=''; } }));

  function clearErr(id){ const el=document.getElementById(id); if(el) el.classList.remove('error'); const er=document.getElementById('err-'+id); if(er) er.classList.remove('visible'); }
  function showErr(id) { const el=document.getElementById(id); if(el) el.classList.add('error');    const er=document.getElementById('err-'+id); if(er) er.classList.add('visible'); }
  function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  let toastTimer;
  function showToast(type, msg){ const t=document.getElementById('toast'),i=document.getElementById('toastIcon'); if(!t)return; t.className='r8-toast '+type; if(i)i.className=type==='success'?'bi bi-check-circle-fill':'bi bi-trash3'; const m=document.getElementById('toastMsg'); if(m)m.textContent=msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),3200); }

  /* ── SEARCH ──────────────────────────────────────────────────────── */
  function filterTable(){ const q=document.getElementById('prodSearch').value.toLowerCase(); const rows=document.querySelectorAll('#prodBody tr'); let v=0; rows.forEach(r=>{ const m=(r.dataset.name||'').includes(q); r.style.display=m?'':'none'; if(m)v++; }); document.getElementById('emptyState').classList.toggle('d-none',v>0); updateCount(); }
  function updateCount(){ const v=[...document.querySelectorAll('#prodBody tr')].filter(r=>r.style.display!=='none').length; const el=document.getElementById('prodCount'); if(el) el.textContent=v+(v===1?' product':' products'); }

  /* ── COLOUR EDITOR ───────────────────────────────────────────────── */
  const clr = { create: [], edit: [] };

  function renderSwatches(ns){
    const el = document.getElementById(ns+'SwatchEditor');
    if(!el) return;
    if(!clr[ns].length){
      el.innerHTML='<span style="font-size:.7rem;color:var(--c-mid);line-height:2">No colours added</span>';
      return;
    }
    el.innerHTML = clr[ns].map((c,i)=>`
      <span class="clr-tag" style="background:${c}" title="${c}">
        <button class="clr-tag-del" onclick="removeColor('${ns}',${i})" title="Remove">×</button>
      </span>`).join('');
  }

  function addColor(ns){
    const v = document.getElementById(ns+'ColorPicker').value;
    if(!clr[ns].includes(v)){ clr[ns].push(v); renderSwatches(ns); }
  }

  function removeColor(ns,i){ clr[ns].splice(i,1); renderSwatches(ns); }

  /* ── CREATE ──────────────────────────────────────────────────────── */
  function openCreateModal(){
    document.getElementById('createName').value='';
    document.getElementById('createDesc').value='';
    document.getElementById('createPrice').value='0';
    document.getElementById('createCategory').value='';
    document.getElementById('createType').value='';
    document.getElementById('createSku').value='';
    document.getElementById('createBadge').value='';
    document.getElementById('createBadgeType').value='';
    clr.create=[]; renderSwatches('create');
    clearErr('createName');
    openModal('createModal');
    setTimeout(()=>document.getElementById('createName').focus(),200);
  }

  async function submitCreate(){
    const name=document.getElementById('createName').value.trim();
    if(!name){ showErr('createName'); return; }
    const body={
      name,
      description: document.getElementById('createDesc').value.trim(),
      price:       parseFloat(document.getElementById('createPrice').value)||0,
      categoryId:  document.getElementById('createCategory').value||'00000000-0000-0000-0000-000000000000',
      typeId:      document.getElementById('createType').value    ||'00000000-0000-0000-0000-000000000000',
      sku:         document.getElementById('createSku').value.trim(),
      badge:       document.getElementById('createBadge').value.trim(),
      badgeType:   document.getElementById('createBadgeType').value,
      color:       [...clr.create],
      imageFiles:  []
    };
    try{
      const resp=await fetch('/api/product',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      if(resp.status===201){
        closeModal('createModal');
        showToast('success',`"${name}" created.`);
        setTimeout(()=>location.reload(),600);
      } else { showToast('error','Create failed: '+resp.status); }
    }catch(e){ console.error(e); showToast('error','Request failed'); }
  }

  /* ── EDIT ────────────────────────────────────────────────────────── */
  function openEditModal(btn){
    document.getElementById('editId').value        = btn.dataset.id;
    document.getElementById('editName').value      = btn.dataset.name;
    document.getElementById('editDesc').value      = btn.dataset.desc      ||'';
    document.getElementById('editPrice').value     = btn.dataset.price     ||'0';
    document.getElementById('editCategory').value  = btn.dataset.catid     ||'';
    document.getElementById('editType').value      = btn.dataset.typeid    ||'';
    document.getElementById('editSku').value       = btn.dataset.sku       ||'';
    document.getElementById('editBadge').value     = btn.dataset.badge     ||'';
    document.getElementById('editBadgeType').value = btn.dataset.badgetype ||'';
    const raw = (btn.dataset.colors||'').trim();
    clr.edit = raw ? raw.split(',').map(s=>s.trim()).filter(Boolean) : [];
    renderSwatches('edit');
    clearErr('editName');
    openModal('editModal');
    setTimeout(()=>document.getElementById('editName').focus(),200);
  }

  async function submitEdit(){
    const id   = document.getElementById('editId').value;
    const name = document.getElementById('editName').value.trim();
    if(!name){ showErr('editName'); return; }
    const body={
      id,
      name,
      description: document.getElementById('editDesc').value.trim(),
      price:       parseFloat(document.getElementById('editPrice').value)||0,
      categoryId:  document.getElementById('editCategory').value||'00000000-0000-0000-0000-000000000000',
      typeId:      document.getElementById('editType').value    ||'00000000-0000-0000-0000-000000000000',
      sku:         document.getElementById('editSku').value.trim(),
      badge:       document.getElementById('editBadge').value.trim(),
      badgeType:   document.getElementById('editBadgeType').value,
      color:       [...clr.edit],
      imageFiles:  []
    };
    try{
      const resp=await fetch(`/api/product/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      if(resp.status===204){
        closeModal('editModal');
        showToast('success',`"${name}" updated.`);
        setTimeout(()=>location.reload(),600);
      } else { showToast('error','Update failed: '+resp.status); }
    }catch(e){ console.error(e); showToast('error','Request failed'); }
  }

  /* ── IMAGES MODAL ────────────────────────────────────────────────── */
  async function openImagesModal(btn){
    const id=btn.dataset.id, name=btn.dataset.name;
    document.getElementById('imagesModalTitle').textContent=`Images — ${name}`;
    document.getElementById('imagesProductId').value=id;
    const inp=document.getElementById('imageUploadInput'); if(inp) inp.value='';
    openModal('imagesModal');
    await loadImages(id);
  }

  async function loadImages(id){
    const grid=document.getElementById('imagesGrid');
    grid.innerHTML='<p style="color:var(--c-mid);font-size:.8rem">Loading…</p>';
    try{
      const resp=await fetch(`/api/product/${id}/images`);
      const files=await resp.json();
      if(!files.length){ grid.innerHTML='<p style="color:var(--c-mid);font-size:.8rem;padding:.5rem 0">No images yet. Upload some below.</p>'; return; }
      grid.innerHTML=files.map(f=>`
        <div class="prod-img-thumb" id="imgthumb-${esc(f)}">
          <img src="/Images/Products/${id}/${esc(f)}" alt="${esc(f)}" onerror="this.style.opacity='.2'">
          <button class="prod-img-del" onclick="deleteImage('${id}','${esc(f)}')" title="Delete image"><i class="bi bi-x-lg"></i></button>
          <span class="prod-img-name">${esc(f)}</span>
        </div>`).join('');
    }catch(e){ grid.innerHTML='<p style="color:var(--c-mid);font-size:.8rem">Error loading images.</p>'; }
  }

  async function deleteImage(productId, fileName){
    if(!confirm(`Delete image "${fileName}"?`)) return;
    try{
      const resp=await fetch(`/api/product/${productId}/images/${encodeURIComponent(fileName)}`,{method:'DELETE'});
      if(resp.status===204){
        showToast('success',`"${fileName}" deleted.`);
        await loadImages(productId);
        refreshThumb(productId);
      } else { showToast('error','Delete failed'); }
    }catch(e){ showToast('error','Request failed'); }
  }

  async function submitImageUpload(){
    const id=document.getElementById('imagesProductId').value;
    const input=document.getElementById('imageUploadInput');
    if(!input||!input.files.length){ showToast('error','Select at least one image'); return; }
    const fd=new FormData();
    for(const f of input.files) fd.append('files',f);
    try{
      const resp=await fetch(`/api/product/${id}/images`,{method:'POST',body:fd});
      if(resp.ok){
        input.value='';
        showToast('success','Images uploaded.');
        await loadImages(id);
        refreshThumb(id);
      } else { const t=await resp.text(); showToast('error','Upload failed: '+resp.status+' '+t); }
    }catch(e){ showToast('error','Request failed'); }
  }

  function refreshThumb(id){
    const img=document.querySelector(`img.prod-thumb[data-id="${id}"]`);
    if(img){ img.src=`/Images/Products/${id}/1.jpg?t=${Date.now()}`; img.style.opacity='1'; }
  }

  /* ── DELETE ──────────────────────────────────────────────────────── */
  let pendingDeleteId=null;
  function openDeleteModal(btn){ pendingDeleteId=btn.dataset.id; const dt=document.getElementById('deleteTarget'); if(dt) dt.textContent=`"${btn.dataset.name}"`; openModal('deleteModal'); }

  async function submitDelete(){
    if(!pendingDeleteId)return;
    try{
      const resp=await fetch(`/api/product/${pendingDeleteId}`,{method:'DELETE'});
      if(resp.status===204){
        document.querySelectorAll('#prodBody tr').forEach(row=>{
          const b=row.querySelector('.btn-tbl-delete');
          if(b&&b.dataset.id===pendingDeleteId){
            const name=b.dataset.name;
            row.style.cssText='transition:opacity .25s,transform .25s;opacity:0;transform:translateX(12px)';
            setTimeout(()=>{ row.remove(); updateCount(); },280);
            showToast('error',`"${name}" deleted.`);
          }
        });
      } else { showToast('error','Delete failed: '+resp.status); }
    }catch(e){ showToast('error','Request failed'); }
    closeModal('deleteModal'); pendingDeleteId=null;
  }

  document.getElementById('editName').addEventListener('input',()=>clearErr('editName'));
  document.getElementById('createName').addEventListener('input',()=>clearErr('createName'));
</script>
