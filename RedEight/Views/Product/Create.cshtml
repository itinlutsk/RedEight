@model RedEight.Models.Product
@{
    Layout = null;
    ViewData["Title"] = "Create Product";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="p-4">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>

        <h1>Create Product</h1>
        <form id="createFormProduct" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <div class="text-danger" asp-validation-for="Name"></div>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Image</label>
                <input type="file" id="imageFile" name="file" accept="image/*" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>

    <script>
        (function(){
            var form = document.getElementById('createFormProduct');
            form.addEventListener('submit', async function(e){
                e.preventDefault();
                var name = form.querySelector('[name="Name"]').value;
                var description = form.querySelector('[name="Description"]').value;
                var price = parseFloat(form.querySelector('[name="Price"]').value) || 0;
                try {
                    var resp = await fetch('/api/product', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: name, description: description, price: price }) });
                    if (resp.status !== 201) { var t = await resp.text(); alert('Create failed: ' + resp.status + '\n' + t); return; }
                    var created = await resp.json(); var id = created.id;
                    var fileInput = document.getElementById('imageFile');
                    if (fileInput && fileInput.files && fileInput.files.length) {
                        var fd = new FormData(); fd.append('files', fileInput.files[0]);
                        var up = await fetch('/api/product/' + id + '/images', { method: 'POST', body: fd });
                        if (!up.ok) { var t = await up.text(); alert('Upload failed: ' + up.status + '\n' + t); return; }
                    }
                    window.location = '/Product';
                } catch (err) { console.error(err); alert('Request failed'); }
            });
        })();
    </script>
</body>
</html>