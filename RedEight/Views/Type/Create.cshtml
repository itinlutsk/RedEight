@model RedEight.Models.Type
@{
    Layout = null;
    ViewData["Title"] = "Create Type";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="p-4">
    <div class="container">
        <h1>Create Type</h1>
        <form id="createForm" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <div class="text-danger" asp-validation-for="Name"></div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var form = document.getElementById('createForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                if ($(form).valid && !$(form).valid()) return; // allow normal submit when invalid
                e.preventDefault();

                var nameField = form.querySelector('[name="Name"]');
                var idField = form.querySelector('[name="Id"]');
                var payload = {
                    Name: nameField ? nameField.value : ''
                };
                if (idField && idField.value) {
                    payload.Id = idField.value;
                }

                fetch('/api/type', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                }).then(function (resp) {
                    if (resp.status === 201) {
                        window.location = '/Type';
                        return;
                    }

                    return resp.text().then(function (text) {
                        alert('Error: ' + resp.status + '\n' + text);
                    });
                }).catch(function (err) {
                    console.error(err);
                    alert('Request failed');
                });
            }, false);
        })();
    </script>
</body>
</html>